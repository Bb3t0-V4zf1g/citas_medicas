# Copia este archivo como .env (o usa "set" en cmd) y pon tus valores reales.
# NUNCA subas el .env real: ya está incluido en .gitignore.

# Secreto para firmar los tokens JWT (obligatorio; usa una cadena larga y aleatoria)
JWT_SECRETO=

# Puerto en el que escucha la API (opcional, 3000 por omisión)
PORT=3000

# Páginas que pueden usar la API desde el navegador (CORS), separadas por coma
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500

# IA externa (Gemini) que clasifica comentarios de pacientes sobre el servicio
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
EXTERNO_URL=https://generativelanguage.googleapis.com
